# No external API keys. No local models.
# Copy this file to .env before running docker compose.

# ── Context Broker ────────────────────────────────────────────────────────────
BROKER_HOST_PORT=3100
BROKER_DEV_PORT=3101

# Token count above which count_tokens recommends compression for briefs/docs
TOKEN_BUDGET_THRESHOLD=700

# Token count above which the orchestrator triggers session file compaction
SESSION_TOKEN_THRESHOLD=1500
