using FluentAssertions;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Logging;
using NSubstitute;
using {{ application_namespace }};
using {{ application_namespace }}.Dtos;
using {{ result_namespace }};
using Xunit;

namespace {{ test_namespace }};

public class {{ feature_name }}ControllerTests
{
    private readonly I{{ entity_name }}Service              _service = Substitute.For<I{{ entity_name }}Service>();
    private readonly ILogger<{{ feature_name }}Controller>  _logger  = Substitute.For<ILogger<{{ feature_name }}Controller>>();
    private readonly {{ feature_name }}Controller           _sut;

    public {{ feature_name }}ControllerTests()
    {
        _sut = new {{ feature_name }}Controller(_service, _logger);
    }
{{ for op in operations -}}
{{ $has_id = op.has_route_id -}}
{{ $is_body = op.http_method == "POST" || op.http_method == "PUT" || op.http_method == "PATCH" }}
    // ── {{ op.name }} ─────────────────────────────────────────────────────────────

    [Fact]
    public async Task {{ op.name }}Async_ShouldReturn{{ op.success_status }}_WhenServiceSucceeds()
    {
        // Arrange
{{ if op.request_dto -}}
        var request  = Valid{{ op.request_dto }}();
{{ end -}}
{{ if $has_id -}}
        var id       = {{ pk_default }};
{{ end -}}
{{ $inner_type = op.response_dto | string.replace "IReadOnlyList<" "" | string.replace "[]" "" | string.replace ">" "" -}}
{{ $is_collection = op.response_is_collection -}}
{{ if $is_collection -}}
        var response = new System.Collections.Generic.List<{{ $inner_type }}>();
{{ else -}}
        var response = new {{ op.response_dto }}({{ pk_default }}{{ for field in fields }}, default{{ end }});
{{ end -}}
{{ if $has_id && op.request_dto -}}
        _service.{{ op.service_method }}(id, request).Returns(Result<IReadOnlyList<{{ $inner_type }}>>.Success(response));
{{ else if $has_id -}}
        _service.{{ op.service_method }}(id).Returns(Result<{{ if $is_collection }}IReadOnlyList<{{ $inner_type }}>{{ else }}{{ op.response_dto }}{{ end }}>.Success(response));
{{ else if op.request_dto -}}
        _service.{{ op.service_method }}(request).Returns(Result<{{ if $is_collection }}IReadOnlyList<{{ $inner_type }}>{{ else }}{{ op.response_dto }}{{ end }}>.Success(response));
{{ else -}}
        _service.{{ op.service_method }}().Returns(Result<{{ if $is_collection }}IReadOnlyList<{{ $inner_type }}>{{ else }}{{ op.response_dto }}{{ end }}>.Success(response));
{{ end }}
        // Act
{{ if $has_id && op.request_dto -}}
        var actionResult = await _sut.{{ op.name }}Async(id, request);
{{ else if $has_id -}}
        var actionResult = await _sut.{{ op.name }}Async(id);
{{ else if op.request_dto -}}
        var actionResult = await _sut.{{ op.name }}Async(request);
{{ else -}}
        var actionResult = await _sut.{{ op.name }}Async();
{{ end }}
        // Assert
        var status = actionResult.Should().BeOfType<ObjectResult>().Subject;
        status.StatusCode.Should().Be({{ op.success_status }});
        status.Value.Should().BeEquivalentTo(response);
    }
{{ if op.request_dto }}
    [Fact]
    public async Task {{ op.name }}Async_ShouldReturn400_WhenServiceFails()
    {
        // Arrange
        var request = Valid{{ op.request_dto }}();
{{ if $has_id }}        var id = {{ pk_default }};
{{ end -}}
{{ if $has_id -}}
        _service.{{ op.service_method }}(id, request).Returns(Result<{{ op.response_dto }}>.Failure(new Error("Validation", "Validation failed.")));
{{ else -}}
        _service.{{ op.service_method }}(request).Returns(Result<{{ op.response_dto }}>.Failure(new Error("Test", "Validation failed.")));
{{ end }}
        // Act
{{ if $has_id -}}
        var actionResult = await _sut.{{ op.name }}Async(id, request);
{{ else -}}
        var actionResult = await _sut.{{ op.name }}Async(request);
{{ end }}
        // Assert
        actionResult.Should().BeOfType<BadRequestObjectResult>();
    }
{{ end -}}
{{ end }}
    // ── helpers ───────────────────────────────────────────────────────────────

{{- $req_fields = fields | array.filter @(do; ret $0.name != "Status"; end) }}
{{ for op in operations -}}
{{ if op.request_dto }}
    private static {{ op.request_dto }} Valid{{ op.request_dto }}() => new(
{{ for field in $req_fields -}}
        {{ field.name }}: {{ if field.type == "string" }}"Valid{{ field.name }}"{{ else if field.type == "int" || field.type == "long" }}1{{ else if field.type == "bool" }}true{{ else if field.type == "Guid" }}Guid.NewGuid(){{ else if field.type == "DateTime" }}DateTime.UtcNow{{ else if field.type == "DateOnly" }}DateOnly.FromDateTime(DateTime.UtcNow){{ else }}default{{ end }}{{ if !for.last }},{{ end }}
{{ end -}}
    );
{{ end -}}
{{ end -}}
}
