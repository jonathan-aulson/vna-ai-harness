{
  "servers": {
    "ado-remote-mcp": {
      "url": "https://mcp.dev.azure.com/vnamow",
      "type": "http"
    },
    "miro": {
      "url": "https://mcp.miro.com/"
    },
    "sql-mcp": {
      "command": "npx",
      "args": ["-y", "@bilims/mcp-sqlserver"],
      "env": {
        "SQLSERVER_HOST": "localhost",
        "SQLSERVER_PORT": "14333",
        "SQLSERVER_DATABASE": "vna-mow2-local-db",
        "SQLSERVER_USER": "sa",
        "SQLSERVER_PASSWORD": "YourStrong@Passw0rd!",
        "SQLSERVER_ENCRYPT": "false",
        "SQLSERVER_TRUST_CERT": "true"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": ""
      }
    },
     "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
     "VNA-dataproduct": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://bot.allata.com/api/dataproduct/tXysCPgAlMWKN1tNAGLV9eNKfFq4rxkWKxNj/mcp"
      ]
    },
    "context-broker": {
      "type": "http",
      "url": "http://localhost:3100/mcp"
    },
    "nx-mcp": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "npx.cmd -y nx-mcp@latest --no-minimal --debugLogs"
      ],
      "cwd": "./frontend"
    },
    "shadcn": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"],
      "cwd": "./frontend"
    }
  }
}